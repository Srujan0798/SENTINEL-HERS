FROM python:3.11-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY api/requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

FROM python:3.11-slim AS runner

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Non-root runtime user (FM-07 hardening — never run the API as root in prod)
RUN useradd --create-home --uid 10001 appuser

# Pip installed to the builder's /root/.local; relocate it to the non-root home.
COPY --from=builder /root/.local /home/appuser/.local

ENV PATH=/home/appuser/.local/bin:$PATH
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
# Default port for local runs; Render (and any host) overrides via $PORT.
ENV PORT=8000

WORKDIR /app

COPY api/ api/
COPY src/ src/
COPY scripts/ scripts/
COPY deployment/render/ deployment/render/

RUN chown -R appuser:appuser /app /home/appuser/.local

USER appuser

# Uses $PORT so the same image runs on Render (injected PORT) and locally.
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
  CMD curl -fsS "http://localhost:${PORT:-8000}/healthz" || exit 1

EXPOSE 8000

# Shell form so ${PORT} is expanded at container start (bind 0.0.0.0:$PORT).
CMD uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000}
