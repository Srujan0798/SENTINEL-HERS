# Secrets — never commit
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo

# Databases (regenerated at runtime / by tests)
*.db
*.sqlite
*.sqlite3

# ML artifacts (regenerated by training)
models/anomaly/*.joblib

# Logs & scratch (root-level runtime output only — NOT the src/backend/logs package)
/logs/
results/*.json
attic/

# Build artifacts
*.zip

# OS
.DS_Store
Thumbs.db
.env.credentials
echo .playwright-cli
.playwright-cli/
