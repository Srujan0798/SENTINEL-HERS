# SENTINEL frontend (Next.js 15) — public env only (FM-07).
# Set these in Vercel → Project → Settings → Environment Variables.
# Root Directory for the Vercel project MUST be: src/frontend

# Backend origin on Render (no trailing slash). Primary production var.
NEXT_PUBLIC_API_BASE_URL=https://sentinel-api.onrender.com

# Legacy aliases (still honoured by the client for local/dev):
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_API_BASE=http://localhost:8000

# Optional SSE/WS origin if realtime is served from a different host.
# Defaults to NEXT_PUBLIC_API_BASE_URL when unset.
# NEXT_PUBLIC_WS_URL=https://sentinel-api.onrender.com
