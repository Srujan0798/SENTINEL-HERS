# --- PostgreSQL (used by docker-compose) ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel

# --- Database ---
DATABASE_URL=postgresql://sentinel:sentinel@postgres:5432/sentinel
REDIS_URL=redis://redis:6379/0
# --- Auth ---
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
# --- AI layer ---
# AI_PROVIDER selects the live provider: claude | gemini | mock.
# If the selected provider's key is absent, the app falls back to the
# deterministic mock provider and logs a WARNING (fail safe + loud).
AI_PROVIDER=claude
# Anthropic (Claude) API key — REDACTED placeholder, never commit a real key.
ANTHROPIC_API_KEY=sk-ant-REDACTED
# Google Gemini API key — REDACTED placeholder, never commit a real key.
GEMINI_API_KEY=AIza-REDACTED
# Optional model override. Defaults: claude -> claude-opus-4-8, gemini -> gemini-1.5-flash.
AI_MODEL=claude-opus-4-8
# --- Integrations (set before wave-5) ---
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Cloud deploy (Render backend) — see docs/DEPLOYMENT.md ---------------
# In production these are injected/managed by Render; values below are
# placeholders for reference only. NEVER commit real secret values (FM-07).
#
# PORT is injected by Render; the container binds 0.0.0.0:$PORT.
PORT=8000
# Allowed CORS origins (comma-separated). Set to the deployed Vercel URL,
# e.g. https://sentinel.vercel.app  — update AFTER the frontend is deployed.
CORS_ORIGINS=https://your-frontend.vercel.app
# JWT_SECRET / JWT_REFRESH_SECRET are auto-generated by Render (generateValue).
# ANTHROPIC_API_KEY / GEMINI_API_KEY / *_WEBHOOK_SECRET are dashboard-only
# secrets on Render (sync: false) — leave blank here.
